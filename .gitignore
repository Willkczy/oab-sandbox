# macOS
.DS_Store

# ══════════════════════════════════════════════════════════════════
# vault/ is a separate repo, not part of this one.
#
# Its remote lives in iCloud, it changes on the rhythm of practice
# sessions, and none of that has anything to do with the lifecycle of
# this sandbox. run.sh treats it as data to mount rather than code --
# see the working_dir comment in config.toml.
#
# To change it: cd vault && git ... -- it has its own branches and
# history over there.
# ══════════════════════════════════════════════════════════════════
vault/

# The real config: holds a Discord account id and a GCP project id.
# Neither is a credential, but neither belongs in a public repo either.
# See config.toml.example for the template.
config/config.toml

# Experiment output. Re-runnable, so it stays out of version control --
# the scripts are the asset.
learn/out/

# Node dependencies. broker's npm install happens inside the image build,
# so this line exists purely to prevent an accidental commit after local
# debugging.
node_modules/

# Python bytecode, produced by the scripts under learn/lib/
__pycache__/
*.pyc

# Claude Code's per-machine settings (output style and so on) -- these
# belong to this machine, not to the project.
.claude/settings.local.json

# Worktrees Claude Code creates for isolated sessions. Each one holds a full
# checkout of this repository, so without this rule a `git add -A` from the
# shared checkout vendors the repo into itself.
.claude/worktrees/

# ══════════════════════════════════════════════════════════════════
# Credentials: never, under any circumstances, in version control.
#
# Nothing in this tree is a real credential today. The SA key lives at
# ~/.config/openab/sa-key.json and is mounted :ro into the broker by
# run.sh; the Discord token arrives through env interpolation. The rules
# below are preventive, they cost nothing, and one accidental
# `git add .` is not something you get to undo.
#
# Note: config/adc-marker.json is an intentional fake, present only to
# satisfy pi's fileExists gate, and it is correctly absent from the list
# below. If it is ever renamed to look more convincing, these rules will
# silently start catching it -- check back here when renaming.
# ══════════════════════════════════════════════════════════════════

# Google Cloud service account keys
sa-key.json
*-key.json
*.serviceaccount.json
application_default_credentials.json

# Credentials that agent CLIs write into the working directory
auth.json
.pi/
.gemini/

# Generic secret patterns
.env
.env.*
*.pem
*.p12
secrets.toml
config.local.toml
