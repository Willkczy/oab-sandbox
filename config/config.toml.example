# ══════════════════════════════════════════════════════════════════
# Template. Copy it to config.toml and fill in your own values:
#
#   cp config/config.toml.example config/config.toml
#
# config.toml itself is gitignored. It carries your Discord account id
# and your GCP project id -- neither is a secret, but neither has any
# reason to sit in a public repository.
#
# Two things to change: allowed_users and GOOGLE_CLOUD_PROJECT.
# ══════════════════════════════════════════════════════════════════

# OpenAB, containerised. Runs alongside the production instance on the
# other machine without interfering with it.
#
# Based on ~/.config/openab/config.toml, with only the container-related
# parts changed. Everything else -- max_sessions, markdown, reactions --
# is copied verbatim, because those settings are conclusions the other
# machine already paid for.
#
# Implementation notes: ../notes.md

[discord]
# Must be the *second* bot's token. Sharing one with the other machine
# means both instances answer every message.
bot_token = "${DISCORD_BOT_TOKEN}"

allow_all_users = false
allowed_users = ["YOUR_DISCORD_USER_ID"]  # your Discord account id (enable Developer Mode, right-click, Copy ID)
allow_all_channels = true
allow_dm = true

[agent]
# The image defaults OPENAB_AGENT_COMMAND to openab-agent, but that binary
# is simply not in the image -- `command -v openab-agent` returns MISSING.
# This line is required, not optional.
command = "pi-acp"

# What gets mounted here is the vault/ directory next to run.sh, a separate
# clone -- not the copy in iCloud. That avoids virtiofs and the write conflicts
# of two machines touching the same files.
working_dir = "/workspace"

# openab runs env_clear on the agent subprocess, keeping only HOME, PATH
# and USER. Every variable below therefore has to be listed explicitly --
# miss one and it fails silently.
#
# GCE_METADATA_HOST  : points at the token broker (S4). No scheme --
#                      gcp-metadata's getBaseUrl() prepends http:// itself.
#                      Note the absence of GOOGLE_APPLICATION_CREDENTIALS.
#                      That absence is the whole point: the key exists only
#                      inside the broker container.
# HTTPS_PROXY etc.   : point at squid (S3). The agent container is on an
#                      --internal network and cannot reach anything without
#                      these.
# NO_PROXY           : the broker and the proxy must not be routed through
#                      the proxy themselves.
env = { PI_ACP_PI_COMMAND = "/home/node/bin/pi-coach", GOOGLE_CLOUD_PROJECT = "your-gcp-project-id", GOOGLE_CLOUD_LOCATION = "global", GCE_METADATA_HOST = "oab-broker:8080", HTTPS_PROXY = "http://oab-proxy:3128", HTTP_PROXY = "http://oab-proxy:3128", NO_PROXY = "localhost,127.0.0.1,oab-proxy,oab-broker" }

# The version on the other machine has
# inherit_env = ["GOOGLE_APPLICATION_CREDENTIALS"]. It is dropped here on
# purpose: that file does not exist in the container, and tokens come from
# the broker.

[pool]
max_sessions = 3
session_ttl_hours = 6

[markdown]
tables = "code"

[reactions]
enabled = true
